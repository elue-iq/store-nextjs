# Copy this file to .env.local and fill it in.
# Without these values the site still runs locally in "dev mode":
#   - the WhatsApp code is printed in the terminal and shown on the page
#   - orders are printed in the terminal instead of going to Telegram
# In production (Vercel) all four are required.

# Any long random string (at least 32 characters). Used to sign the OTP token.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# OTPIQ project key from https://app.otpiq.com (starts with sk_live_ or sk_dev_)
OTPIQ_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# The group chat id where orders should arrive (usually starts with -100...)
TELEGRAM_CHAT_ID=
